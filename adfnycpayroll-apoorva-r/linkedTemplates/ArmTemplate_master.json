{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfnycpayroll-apoorva-r"
		},
		"LS_ADLS_NYC_Payroll_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_NYC_Payroll'"
		},
		"LS_SQL_NYC_Payroll_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_SQL_NYC_Payroll'"
		},
		"LS_ADLS_NYC_Payroll_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsnycpayrollapoorvar.dfs.core.windows.net/"
		},
		"LS_Synapse_NYC_Payroll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "synnycpayroll-apoorva-r-ondemand.sql.azuresynapse.net"
		},
		"LS_Synapse_NYC_Payroll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "udacity"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfnycpayroll-apoorva-r_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_NYC_Payroll_accountKey": {
						"value": "[parameters('LS_ADLS_NYC_Payroll_accountKey')]"
					},
					"LS_SQL_NYC_Payroll_connectionString": {
						"value": "[parameters('LS_SQL_NYC_Payroll_connectionString')]"
					},
					"LS_ADLS_NYC_Payroll_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_NYC_Payroll_properties_typeProperties_url')]"
					},
					"LS_Synapse_NYC_Payroll_properties_typeProperties_server": {
						"value": "[parameters('LS_Synapse_NYC_Payroll_properties_typeProperties_server')]"
					},
					"LS_Synapse_NYC_Payroll_properties_typeProperties_database": {
						"value": "[parameters('LS_Synapse_NYC_Payroll_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfnycpayroll-apoorva-r_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfnycpayroll-apoorva-r_ArmTemplate_0')]"
			]
		}
	]
}